; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Shift"
run/main_scene="uid://bqh6201u57gpa"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="uid://dn14nabkjud6f"
config/icon="res://Assets/textures/icon.svg"

[autoload]

GlobalScript="*res://Scripts/globalScript.gd"
Console="*res://addons/console/console.gd"
Signal_Debugger="*res://addons/SignalVisualizer/Debugger/SignalDebugger.gd"

[display]

window/size/mode=2

[dotnet]

project/assembly_name="ProjectShift"

[editor_plugins]

enabled=PackedStringArray("res://addons/SignalVisualizer/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Scenes/": "blue",
"res://Scripts/": "red"
}

[global_group]

canGrab="if an object is in this group, you can grab it"
player=""

